rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {


    // Phase A: single operator email — must match assets/admin-auth.js ADMIN_EMAILS
    // and api/lib/admin-emails.js (used by /api/admin-ai Bearer gate).
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['lucaspaye02@gmail.com'];
    }


    // Orders — checkout creates orders without requiring an account.
    // Reads/updates are restricted to the admin or the logged-in owner
    // (buyerEmail == auth email). Guest flows go through server endpoints
    // that check the ref / confirmToken and return status only:
    //   /api/order-status            (track-order.html)
    //   /api/order-confirm-delivery  (confirm-delivery.html)
    // confirm-payment.html now requires the admin to be signed in.
    function isOrderOwner() {
      return request.auth != null
        && request.auth.token.email != null
        // exact match so account.html's where('buyerEmail','==',email) query is provable
        && resource.data.buyerEmail == request.auth.token.email;
    }
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || isOrderOwner();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Customers — signup can create a record for the account just
    // created; after that, only that same authenticated person can
    // read or update their own record.
    match /customers/{docId} {
      allow create: if request.auth != null
                      && request.resource.data.email == request.auth.token.email;
      allow read: if request.auth != null
                      && (resource.data.email == request.auth.token.email || isAdmin());
      allow update: if request.auth != null
                      && (resource.data.email == request.auth.token.email || isAdmin());
      allow delete: if false;
    }

    // Analytics counters — write-only for anonymous visitors (so the site
    // itself can log a visit), but readable by the admin dashboard so it
    // can actually display the numbers it collects. Restricted to the two
    // real admin accounts rather than "any authenticated user", since
    // customers can also create Firebase Auth accounts via auth.html and
    // shouldn't be able to read business analytics.
    match /analytics_visits/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /analytics_days/{id} {
      allow write: if true;
      allow read: if isAdmin();
    }

    // Shared admin dashboard state (products, promo codes, notifications,
    // security log, AI relationship memory) — was previously stuck in
    // whichever single browser last touched it (localStorage only), so
    // the two admin accounts could see completely different things.
    // Centralizing here means both accounts, and the AI acting on either
    // one's behalf, always see the same real state.
    match /admin_state/{docId} {
      allow read, write: if isAdmin();
    }

    // Simple connectivity check used by the site itself.
    match /_health_/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Live chat human handoff — session ID is a high-entropy UUID (secret
    // link, same pattern as guest order tracking). Clients create sessions
    // and write user/assistant/system messages; only operators write staff
    // messages, claim sessions, or set status to "human".
    match /chat_sessions/{sessionId} {
      // get-only for the public: the widget knows its own random session ID.
      // Listing/querying all sessions is admin-only (dashboard + server bridge).
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['status', 'createdAt', 'updatedAt'])
                      && request.resource.data.status in ['waiting', 'ai']
                      && request.resource.data.status is string;
      allow update: if isAdmin()
                      || (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly([
                            'status', 'updatedAt', 'lastMessage', 'lastMessageAt',
                            'lastMessageRole', 'unreadStaff', 'unreadClient',
                            'pageUrl', 'preview', 'clientLastSeenAt',
                            'sessionCode', 'waBridgeChatId', 'waBridgeEnabled',
                            'handoffReason', 'clientName', 'clientPhone',
                            'clientEmail', 'clientUid', 'askingAbout'
                          ])
                        && request.resource.data.status is string
                        // Keep same status (incl. human while chatting), or move
                        // between waiting/ai/closed. Never escalate to human.
                        && (
                          request.resource.data.status == resource.data.status
                          || (
                            request.resource.data.status in ['waiting', 'ai', 'closed']
                            && resource.data.status in ['waiting', 'ai', 'closed']
                          )
                        )
                      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        // Readable only via the (secret) parent session path; there is no
        // collection-group rule, so messages can't be enumerated across sessions.
        allow read: if true;
        allow create: if
          (
            isAdmin()
            && request.resource.data.role in ['staff', 'system', 'assistant', 'user']
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 4000
          )
          || (
            request.resource.data.role in ['user', 'assistant', 'system']
            && request.resource.data.keys().hasAll(['role', 'content', 'createdAt'])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 4000
          );
        allow update, delete: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
