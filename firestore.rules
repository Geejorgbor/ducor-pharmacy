rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Orders — checkout creates orders without requiring an account.
    // Tracking (by ref), delivery confirmation, and payment confirmation
    // are all public "secret link" flows for guest checkout, so reads
    // stay open. Updates are restricted to only the status/confirmation
    // fields the site's own code ever writes — price, items, and buyer
    // info are locked after creation so a guessed/leaked link can't be
    // used to tamper with an order's contents.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly([
                        'status', 'statusUpdatedAt', 'confirmToken',
                        'deliveredAt', 'confirmedByCustomer',
                        'paymentConfirmed', 'paymentConfirmedAt', 'adminNote'
                      ]);
      allow delete: if false;
    }

    // Customers — signup can create a record for the account just
    // created; after that, only that same authenticated person can
    // read or update their own record.
    match /customers/{docId} {
      allow create: if request.auth != null
                      && request.resource.data.email == request.auth.token.email;
      allow read, update: if request.auth != null
                      && resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // Analytics counters — write-only for anonymous visitors (so the site
    // itself can log a visit), but readable by the admin dashboard so it
    // can actually display the numbers it collects. Restricted to the two
    // real admin accounts rather than "any authenticated user", since
    // customers can also create Firebase Auth accounts via auth.html and
    // shouldn't be able to read business analytics.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['lucaspaye02@gmail.com', 'ducor.adminducorpharmacy@gmail.com'];
    }
    match /analytics_visits/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /analytics_days/{id} {
      allow write: if true;
      allow read: if isAdmin();
    }

    // Shared admin dashboard state (products, promo codes, notifications,
    // security log, AI relationship memory) — was previously stuck in
    // whichever single browser last touched it (localStorage only), so
    // the two admin accounts could see completely different things.
    // Centralizing here means both accounts, and the AI acting on either
    // one's behalf, always see the same real state.
    match /admin_state/{docId} {
      allow read, write: if isAdmin();
    }

    // Simple connectivity check used by the site itself.
    match /_health_/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
